# SRP SmartRecruit - recruit.srpailabs.com
# ★ PRODUCTION SOURCE OF TRUTH (RC1) — Next.js SmartRecruit on :3010
# Frontend CI deploys this file to /etc/nginx/sites-available/recruit.srpailabs.com
# Legacy FastAPI ATS on :8009 is only used for /static/ and optional /api/legacy-ats.
#
# Rate limits apply to all Next /api/* including /api/screen, /api/bulk-jobs, /api/search.

limit_req_zone $binary_remote_addr zone=ats_api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=ats_auth:10m rate=5r/s;

server {
    listen 80;
    listen [::]:80;
    server_name recruit.srpailabs.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name recruit.srpailabs.com;

    ssl_certificate     /etc/letsencrypt/live/recruit.srpailabs.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/recruit.srpailabs.com/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;
    client_max_body_size 25M;
    # Return JSON (not HTML) when nginx rejects oversized uploads
    error_page 413 = @json_413;

    location @json_413 {
        default_type application/json;
        return 413 '{"error":"File too large (max 25 MB). Export a smaller PDF or paste the text."}';
    }

    # ── NextAuth + Next.js auth routes --> Next.js :3010
    location ~ ^/api/auth/(providers|session|csrf|callback|signin|signout|error|forgot-password|reset-password|signup)(/.*)?$ {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Optional: keep a narrow legacy FastAPI escape hatch (old ATS only)
    location ~ ^/api/(legacy-ats)(/.*)?$ {
        limit_req zone=ats_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8009;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # ── ALL other /api/* --> Next.js SmartRecruit (:3010)
    # This fixes AI Assistant (/api/coach), insights, analytics, offers, ESS, etc.
    location /api/ {
        limit_req zone=ats_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
        proxy_connect_timeout 15s;
        client_max_body_size 25M;
    }

    location /health {
        proxy_pass http://127.0.0.1:3010/api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /app {
        return 301 /dashboard;
    }

    # Legacy FastAPI static only (if still used by old assets)
    location /static/ {
        proxy_pass http://127.0.0.1:8009;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    location /_next/static/ {
        proxy_pass http://127.0.0.1:3010;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
        proxy_connect_timeout 15s;
    }

    location ~ /\. {
        deny all;
    }
}
