# Copy to .env.e2e.local (gitignored) — credentials user for Playwright authenticated E2E.
# User must exist in auth_users with password_hash (email/password sign-in), be active,
# and have an accepted tenant_members row (or will provision on first login).

E2E_USER_EMAIL=e2e-recruiter@example.com
E2E_USER_PASSWORD=your-secure-test-password

# Only if PLAYWRIGHT_BASE_URL is NOT localhost (e.g. staging) — prevents accidental prod login.
# E2E_ALLOW_REMOTE_AUTH=1
